[Unit]
Description=Nightly DSH cognee-memory ingest drain (04:00 local)

[Timer]
OnCalendar=*-*-* 04:00:00
# If the host was off at 04:00, run once on the next boot rather than silently
# skipping a night's backfill.
Persistent=true
RandomizedDelaySec=300
Unit=dsh-cognify-queue.service

[Install]
WantedBy=timers.target
